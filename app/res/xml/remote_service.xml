<?xml version="1.0" encoding="utf-8"?>
<!--
  The accessibility service exists for one reason: a launcher only receives key
  events while it is the focused window, and the whole point of the branded keys on
  the remote is that you press them from inside Netflix. Filtering key events is the
  only route on Android without root.

  It asks for the narrowest thing that works: no window content, no event types, no
  retrieval of what is on screen. flagRequestFilterKeyEvents and nothing else.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0"
    android:description="@string/remote_service_desc"
    android:summary="@string/remote_service_summary" />
