<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ghidi.lumen"
    android:versionCode="6"
    android:versionName="3.2">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="30" />

    <!-- Reads the television's own watch-next rows: what you were part-way through, and the
         intent that resumes it. A normal runtime permission, asked for once on first run. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Poster art on the Carry on cards, and nothing else. Turning "Poster art" off in
         Settings stops every request Lumen would otherwise make. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Lumen"
        android:theme="@style/LumenTheme"
        android:allowBackup="false">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AllAppsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".AppsOnHomeActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".FirstBootActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".SourcesActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".RemoteActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!--
          Key filtering is the only way, without root, to notice a remote button while
          another app is on screen. The service declares the narrowest configuration that
          works and the person has to switch it on by hand in the TV's own settings.
        -->
        <service
            android:name=".RemoteService"
            android:exported="true"
            android:label="Lumen remote keys"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_service" />
        </service>
    </application>
</manifest>
